const arrayA = [3, 7, 12, 19, 24, 31, 38, 45, 50, 6];
const arrayB = [9, 14, 21, 28, 33, 19, 41, 47, 6, 52];
const comuns = [];

for (let i = 0; i < arrayA.length; i++) {
  for (let j = 0; j < arrayB.length; j++) {
    if (arrayA[i] === arrayB[j]) {
      comuns.push(arrayA[i]);
    }
  }
}

console.log('Números em comum:', comuns);